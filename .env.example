# exifcalibur configuration - copy to .env and fill in your values
# Precedence: CLI flags > environment variables > this file > defaults

# Required: API key of your OpenAI-compatible endpoint
API_KEY=

# OpenAI-compatible base URL (no trailing slash)
BASE_URL=https://openrouter.ai/api/v1

# Vision model name
MODEL=minimax/minimax-m3.1-flash:free

# Language code for the written metadata (e.g. en, pt-BR, es)
LANG=en

# Parallel API calls
WORKERS=1
